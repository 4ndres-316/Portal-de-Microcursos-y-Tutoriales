@model Curso

@{
    ViewData["Title"] = Model.Titulo;
    var inscrito = (bool)(ViewData["Inscrito"] ?? false);
}

<h1>@Model.Titulo</h1>

<p>@Model.Descripcion</p>

<p><strong>Nivel:</strong> @Model.Nivel</p>
<p><strong>Duración:</strong> @Model.DuracionHoras horas</p>
<p><strong>Lecciones:</strong> @Model.Lecciones.Count</p>

@if (inscrito)
{
    <p>Ya estás inscrito en este curso.</p>
    <p>
        <a asp-controller="Inscripciones" asp-action="MisCursos">Ir a mis cursos</a>
    </p>
}
else
{
    <form asp-controller="Inscripciones" asp-action="Inscribir" method="post">
        <input type="hidden" name="cursoId" value="@Model.Id" />
        <button type="submit" class="btn btn-primary">Inscribirme</button>
    </form>
}
