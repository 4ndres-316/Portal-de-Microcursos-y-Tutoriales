@model IEnumerable<MisCursosItem>

@{
    ViewData["Title"] = "Mis cursos";
}

<h1>Mis cursos</h1>

@if (!Model.Any())
{
    <p>No estás inscrito en ningún curso.</p>
    <p>
        <a asp-controller="Cursos" asp-action="Index">Ver catálogo de cursos</a>
    </p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Curso</th>
                <th>Nivel</th>
                <th>Progreso</th>
                <th>Fecha de inscripción</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Curso.Titulo</td>
                    <td>@item.Curso.Nivel</td>
                    <td>@item.Completadas de @item.TotalLecciones (@item.Porcentaje%)</td>
                    <td>@item.FechaInscripcion.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-controller="Lecciones" asp-action="Curso" asp-route-cursoId="@item.Curso.Id">Ver lecciones</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
