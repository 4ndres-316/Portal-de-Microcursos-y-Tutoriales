@model Leccion

@{
    ViewData["Title"] = Model.Titulo;
    var lecciones = (List<Leccion>)ViewData["Lecciones"]!;
    var completadas = (List<int>)ViewData["Completadas"]!;
}

<h1>@Model.Titulo</h1>

<p><strong>Curso:</strong> @Model.Curso?.Titulo</p>

<div class="row">
    <div class="col-md-4">
        <h5>Lecciones del curso</h5>
        <ul>
            @foreach (var item in lecciones)
            {
                <li>
                    @(completadas.Contains(item.Id) ? "✔" : "○")
                    @if (item.Id == Model.Id)
                    {
                        <strong>@item.Titulo</strong>
                    }
                    else
                    {
                        <a asp-action="Ver" asp-route-id="@item.Id">@item.Titulo</a>
                    }
                </li>
            }
        </ul>
    </div>
    <div class="col-md-8">
        @Html.Raw(Model.Contenido)

        <hr />

        @if (completadas.Contains(Model.Id))
        {
            <p><strong>Lección completada.</strong></p>
        }
        else
        {
            <form asp-action="MarcarCompletada" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-success">Marcar como completada</button>
            </form>
        }
    </div>
</div>
