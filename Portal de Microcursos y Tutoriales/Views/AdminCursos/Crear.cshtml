@model Curso

@{
    ViewData["Title"] = "Nuevo curso";
    var niveles = new[] { "Básico", "Intermedio", "Avanzado" };
}

<h1 class="section-title">Nuevo curso</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Crear" method="post">
            <div class="mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nivel" class="form-label"></label>
                <select asp-for="Nivel" class="form-select">
                    <option value="">-- Seleccione un nivel --</option>
                    @foreach (var n in niveles)
                    {
                        <option value="@n">@n</option>
                    }
                </select>
                <span asp-validation-for="Nivel" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DuracionHoras" class="form-label"></label>
                <input asp-for="DuracionHoras" class="form-control" type="number" min="1" />
                <span asp-validation-for="DuracionHoras" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Publicado" class="form-check-input" />
                <label asp-for="Publicado" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
